# Local development environment for docker compose. Copy to .env and customize.
KUBEPILOT_AUTH_SECRET=replace-with-at-least-32-random-characters
KUBEPILOT_DB_USER=kubepilot
KUBEPILOT_DB_PASSWORD=change-me
KUBEPILOT_DB_NAME=kubepilot
KUBEPILOT_CLUSTER_NAME=primary
KUBEPILOT_SERVICE_NAME=kubepilot-api
KUBEPILOT_ADMIN_EMAIL=ops@kubepilot.io
KUBEPILOT_ADMIN_PASSWORD=kubepilot
KUBEPILOT_BACKEND_URL=http://backend:8000
